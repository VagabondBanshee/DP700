annotation TranslationsBuilder = Version:2.2-Updated:2025-11-01

annotation __TEdtr = 1

ref table dBarrio
ref table dTipo_Incidencia
ref table fHechos_Incidencias
ref table dCalendario
ref table Idiomas
ref table 'Nombre Tipo Incidencia'
ref table 'Nombre Barrio Traducido'
ref table 'Nombre Mes Traducido'
