  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "1e38505d-88f3-4bac-bfff-874f3bcaac60"
      },
      "text": "// Escriba su consulta KQL (ejemplo):\n// <table name>\n// | where <columna de fecha y hora> between (['_startTime'] .. ['_endTime']) // Filtrado de intervalo de tiempo\n// | take 100\nvwCrypto\n   | top 1 by serverTime\n   | project serverTime",
      "id": "db6d56b2-7fc4-4404-923a-81873f915455",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "1e38505d-88f3-4bac-bfff-874f3bcaac60"
      },
      "text": "// Escriba su consulta KQL (ejemplo):\n// <table name>\n// | where <columna de fecha y hora> between (['_startTime'] .. ['_endTime']) // Filtrado de intervalo de tiempo\n// | take 100\n   materialized_view('mvCryptoGoldLatest')\n   | summarize Cryptocurrencies = count_distinct(symbol)",
      "id": "72d2ade0-274b-472f-960c-cf1ce92baf0e",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "1e38505d-88f3-4bac-bfff-874f3bcaac60"
      },
      "text": "// Escriba su consulta KQL (ejemplo):\n// <table name>\n// | where <columna de fecha y hora> between (['_startTime'] .. ['_endTime']) // Filtrado de intervalo de tiempo\n// | take 100\n    materialized_view('mvCryptoGoldLatest')\n    | where symbol endswith \"EUR\"\n    | top 5 by price",
      "id": "868783ee-b1c9-44cf-b96e-caa04f8a8306",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "1e38505d-88f3-4bac-bfff-874f3bcaac60"
      },
      "text": "// Escriba su consulta KQL (ejemplo):\n// <table name>\n// | where <columna de fecha y hora> between (['_startTime'] .. ['_endTime']) // Filtrado de intervalo de tiempo\n// | take 100\nmaterialized_view('mvCryptoGoldLatest')\n    | extend priceRange = case(\n        price < 1, \"< 1€\",\n        price < 100, \"1€ - 100€\",\n        price < 1000, \"100€ - 1000€\",\n        \"> 1000€\"\n    )\n    | summarize count() by priceRange",
      "id": "b9da838a-d6b3-4c13-ae4b-46bcd45e49b9",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "1e38505d-88f3-4bac-bfff-874f3bcaac60"
      },
      "text": " materialized_view('mvCryptoGoldLatest')\n   | where symbol == Criptomoneda\n   | project symbol",
      "id": "73cd2ba0-d224-400f-a2da-3615b1eb0bcd",
      "usedVariables": [
        "Criptomoneda"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "1e38505d-88f3-4bac-bfff-874f3bcaac60"
      },
      "text": " vwCrypto\n   | where symbol == Criptomoneda\n   | where serverTime between (_startTime .. _endTime)\n   | summarize max(price)",
      "id": "8d95a3d3-c63e-4915-bf10-586dfea2ff2b",
      "usedVariables": [
        "Criptomoneda",
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "1e38505d-88f3-4bac-bfff-874f3bcaac60"
      },
      "text": "mvCryptoGoldLatest\n   | where symbol == Criptomoneda\n   | top 1 by serverTime desc\n   | project current_price = price",
      "id": "4b33c1ca-7974-4eda-8643-0de78c8ae70c",
      "usedVariables": [
        "Criptomoneda"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "1e38505d-88f3-4bac-bfff-874f3bcaac60"
      },
      "text": "vwCrypto\n   | where symbol == Criptomoneda\n   | where serverTime between (_startTime.._endTime)\n   | summarize \n      max_price = max(price),\n      min_price = min(price)\n   | extend variation_pct = ((max_price - min_price) / min_price) * 100\n   | project variation_pct",
      "id": "25a8014f-f785-4dfd-9dfc-6b221718e6e2",
      "usedVariables": [
        "Criptomoneda",
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "1e38505d-88f3-4bac-bfff-874f3bcaac60"
      },
      "text": " let current_price = \n      mvCryptoGoldLatest\n      | where symbol == Criptomoneda;\n   let last_historical = \n      vwCrypto\n      | where symbol == Criptomoneda\n      | where serverTime between (_startTime .. _endTime)\n      | top 1 by serverTime asc\n      | project lh_symbol = symbol, lh_serverTime = serverTime, lh_price = price;\n   current_price\n   | join kind=inner last_historical on $left.symbol == $right.lh_symbol\n   | extend variation_pct = ((price - lh_price) / price) * 100\n   | project variation_pct",
      "id": "ccc73c54-0791-4a64-bd5e-fb69cf67009a",
      "usedVariables": [
        "Criptomoneda",
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "1e38505d-88f3-4bac-bfff-874f3bcaac60"
      },
      "text": "// Escriba su consulta KQL (ejemplo):\n// <table name>\n// | where <columna de fecha y hora> between (['_startTime'] .. ['_endTime']) // Filtrado de intervalo de tiempo\n// | where isempty(['Criptomoneda']) or <nombre de columna> == ['Criptomoneda'] // Filtrado de selección única\n// | take 100\n vwCrypto\n   | where symbol == Criptomoneda\n   | where serverTime between (_startTime .. _endTime)\n   | summarize min(price)",
      "id": "d883b2df-d29e-4cda-bcf6-77276acc69fb",
      "usedVariables": [
        "Criptomoneda",
        "_endTime",
        "_startTime"
      ]
    },
    {
